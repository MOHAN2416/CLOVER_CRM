{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://your-backend.onrender.com/api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "/frontend/static/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/templates/$1"
    },
    {
      "source": "/",
      "destination": "/frontend/templates/index.html"
    }
  ]
}
